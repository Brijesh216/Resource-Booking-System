# Copy this file to .env (or export these as real environment variables) before running the app.

# ---- Server ----
SERVER_PORT=9000

# ---- Database (PostgreSQL example - default) ----
DB_URL=jdbc:postgresql://localhost:5432/booking_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# ---- Database (MySQL example - use with --spring.profiles.active=mysql instead) ----
# DB_URL=jdbc:mysql://localhost:3306/booking_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=root

# ---- JPA ----
DDL_AUTO=update
SHOW_SQL=false

# ---- JWT ----
# Must be at least 32 characters (256 bits) for HS256. CHANGE THIS IN PRODUCTION.
JWT_SECRET=change-this-super-secret-key-min-32-chars-long-please
JWT_EXPIRATION_MS=86400000

# ---- Logging ----
LOG_LEVEL=INFO
